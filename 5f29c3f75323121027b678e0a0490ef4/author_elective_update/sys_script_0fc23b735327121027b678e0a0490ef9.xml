        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var taskList = [
        {name: "Create Employee Account", group: "IT Support"},
        {name: "Issue Laptop", group: "IT Equipment"},
        {name: "Schedule HR Orientation", group: "HR"},
        {name: "Assign Mentor", group: "Management"}
    ];

    taskList.forEach(function(task) {
        var newTask = new GlideRecord('x_hr_onboarding_task');
        newTask.initialize();
        newTask.parent_request = current.sys_id;
        newTask.short_description = task.name;
        newTask.assignment_group.setDisplayValue(task.group);
        newTask.state = '1'; // Open
        newTask.insert();
    });
})(current, previous);
]]></script>
