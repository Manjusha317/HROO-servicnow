        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var department = current.department.getDisplayValue();
    var hrGroup = ''; 

    if (department == 'IT') {
        hrGroup = 'IT HR Group';
    } else if (department == 'Finance') {
        hrGroup = 'Finance HR Group';
    } else {
        hrGroup = 'General HR Group';
    }

    current.assignment_group.setDisplayValue(hrGroup);
})(current, previous);
]]></script>
