        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var approvers = [
        current.manager, // Hiring Manager
        "HR Head", // Static assignment
        "IT Manager" // Static assignment
    ];

    approvers.forEach(function(user) {
        var approval = new GlideRecord('x_hr_onboarding_approval');
        approval.initialize();
        approval.parent_request = current.sys_id;
        approval.approver = user;
        approval.status = 'Requested';
        approval.insert();
    });
})(current, previous);
]]></script>
