        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var reqType = current.variables.request_type; // Fetch Onboarding or Offboarding

    var approval = new GlideRecord('sys_approval_approver');
    approval.initialize();
    approval.source_table = "sc_req_item";
    approval.source = current.sys_id;
    approval.approver = current.opened_by.manager; // Assign to requestor's manager
    approval.state = "requested";
    approval.insert();
})();
]]></script>
