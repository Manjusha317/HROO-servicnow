        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var reqItem = new GlideRecord('sc_req_item');
    if (reqItem.get(current.sysapproval)) {
        if (current.state == 'approved') {
            reqItem.state = '3'; // Approved
            reqItem.update();
            
            // Auto-create tasks for onboarding
            var task = new GlideRecord('sc_task');
            task.initialize();
            task.request_item = reqItem.sys_id;
            task.short_description = 'Provision Laptop & Access';
            task.assignment_group = 'Hardware Team';
            task.insert();
            
        } else if (current.state == 'rejected') {
            reqItem.state = '4'; // Rejected
            reqItem.update();
        }
    }
})(current, previous);
]]></script>
