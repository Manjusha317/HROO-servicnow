        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Get the requester's manager
    var manager = current.requested_for.manager;
    
    if (manager) {
        var approval = new GlideRecord('sys_approval');
        approval.initialize();
        approval.document_id = current.sys_id;  // Link to the request
        approval.table_name = current.getTableName();  // Set the table name
        approval.approver = manager;  // Assign to manager
        approval.state = 'requested';  // Set approval state
        approval.insert();
        
        gs.info("Approval record created for manager: " + manager.name);
    } else {
        gs.warn("No manager found for user: " + current.requested_for.name);
    }

})(current, previous);
]]></script>
