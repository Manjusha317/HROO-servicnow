        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    if (current.cat_item == '54d0dc4e5363121027b678e0a0490eef') {  
        
        // Create an approval record for the manager
        var approval = new GlideRecord('sysapproval_approver');
        approval.initialize();
        approval.approver = current.variables.manager; // Manager selected in the catalog item
        approval.sysapproval = current.sys_id; // Reference to the Request Item
        approval.state = 'requested'; // Set to "Requested"
        approval.insert();

        // Update the state to "Pending Approval"
        current.state = '2'; // 2 = Pending Approval
        current.update();
    }
})(current, previous);
]]></script>
