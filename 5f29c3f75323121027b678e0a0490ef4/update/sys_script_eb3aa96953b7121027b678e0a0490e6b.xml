        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var gr = new GlideRecord('x_onboarding_task');
    gr.addQuery('request', current.request);
    gr.addQuery('state', '!=', 'Completed');
    gr.query();

    if (!gr.hasNext()) {
        var req = new GlideRecord('x_onboarding_request');
        if (req.get(current.request)) {
            req.state = 'Completed';
            req.update();
        }
    }


