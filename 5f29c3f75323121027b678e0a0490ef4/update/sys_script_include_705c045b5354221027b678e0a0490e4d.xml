        <api_name>x_1583423_hr_hroo.User Details</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description>script include to add in catalog client script to auto populate user details</description>
        <mobile_callable>false</mobile_callable>
        <name>User Details</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var UserDetails = Class.create();
UserDetails.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    getUserDetails: function() {
        var userID = this.getParameter('sysparm_user');
        var user = new GlideRecord('sys_user');
        if (user.get(userID)) {
            var userData = {
                email: user.email.toString(),
				department: user.department.toString(),
            };
            return JSON.stringify(userData);
        }
        return '{}';
    }
});]]></script>
