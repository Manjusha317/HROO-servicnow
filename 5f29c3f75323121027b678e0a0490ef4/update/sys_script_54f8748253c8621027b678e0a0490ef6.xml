        <script><![CDATA[(function executeRule(current, gForm, gSNC) {
    var grApproval = new GlideRecord('sysapproval_approver'); // Approvals table
    grApproval.initialize();

    grApproval.approver = current.requested_for; // Assign approval to the employee’s manager
    grApproval.state = 'requested';
    grApproval.sysapproval = current.sys_id; // Attach approval to this request
    grApproval.insert();

    gs.addInfoMessage("Approval request sent to Manager.");
})(current, gForm, gSNC);]]></script>
