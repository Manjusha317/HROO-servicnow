        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var request = new GlideRecord('x_hr_onboarding_request');
    if (request.get(current.parent_request)) {
        request.state = (current.status == 'Approved') ? 'In Progress' : 'Rejected';
        request.update();

        // Close other pending approvals
        var approvals = new GlideRecord('x_hr_onboarding_approval');
        approvals.addQuery('parent_request', current.parent_request);
        approvals.addQuery('status', 'Requested');
        approvals.query();
        while (approvals.next()) {
            approvals.status = 'No Longer Requested';
            approvals.update();
        }
    }
})(current, previous);
]]></script>
