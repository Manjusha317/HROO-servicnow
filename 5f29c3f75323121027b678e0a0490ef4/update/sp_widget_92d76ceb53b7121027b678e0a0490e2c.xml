<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="INSERT_OR_UPDATE">
        <category>custom</category>
        <client_script><![CDATA[api.controller=function($scope, $http) {
    $scope.kbResults = [];

    $scope.searchKB = function() {
        if ($scope.query.length < 3) {
            $scope.kbResults = [];
            return;
        }

        var kbUrl = "/api/now/table/kb_knowledge?sysparm_query=short_descriptionLIKE" + encodeURIComponent($scope.query);
        
        $http.get(kbUrl).then(function(response) {
            $scope.kbResults = response.data.result.map(function(article) {
                return {
                    title: article.short_description,
                    url: "/kb_view.do?sys_id=" + article.sys_id
                };
            });
        });
    };
}
]]></client_script>
