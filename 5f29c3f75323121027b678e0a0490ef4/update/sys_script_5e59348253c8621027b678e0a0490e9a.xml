        <script><![CDATA[(function executeRule(current, gForm, gSNC) {
    var task = new GlideRecord('sc_task'); // Service Catalog Task table
    task.initialize();
    
    if (current.cat_item == 'Onboarding Request') {
        task.short_description = "Set up Laptop & Email";
        task.assignment_group = "IT Support";
    } else if (current.cat_item == 'Offboarding Request') {
        task.short_description = "Revoke System Access";
        task.assignment_group = "IT Security";
    }
    
    task.request_item = current.sys_id;
    task.state = "1"; // Open
    task.insert();
    
    gs.addInfoMessage("Task created for fulfillment.");
})(current, gForm, gSNC);
]]></script>
